#!/usr/bin/env bash
set -o pipefail

IPT="/usr/sbin/iptables"
CHAIN="{{ hbr_ac04_chain }}"
IFACE="{{ hbr_ac04_interface }}"
HOST_IP="{{ hbr_ac04_host_ip }}"
PORT="{{ hbr_ac04_port }}"
COMMENT="{{ hbr_ac04_rule_comment }}"

SOURCES=(
{% for item in hbr_ac04_sources %}
  "{{ item.address }}/32"
{% endfor %}
)

jump_args=(
  -i "$IFACE"
  -p tcp
  -m conntrack
  --ctorigdst "$HOST_IP"
  --ctorigdstport "$PORT"
  -m comment
  --comment "$COMMENT"
  -j "$CHAIN"
)

chain_exists() {
  "$IPT" -w 5 -t filter -S "$CHAIN" >/dev/null 2>&1
}

remove_jump() {
  while "$IPT" -w 5 -t filter -C DOCKER-USER "${jump_args[@]}" >/dev/null 2>&1
  do
    "$IPT" -w 5 -t filter -D DOCKER-USER "${jump_args[@]}" || return 21
  done
  return 0
}

verify_rules() {
  "$IPT" -w 5 -t filter -C DOCKER-USER "${jump_args[@]}" >/dev/null 2>&1 || return 31

  local jumps
  jumps="$("$IPT" -w 5 -t filter -S DOCKER-USER 2>/dev/null |
    grep -F -- "-j $CHAIN" | wc -l)"
  [ "$jumps" -eq 1 ] || return 32

  chain_exists || return 33

  local actual expected src
  actual="$("$IPT" -w 5 -t filter -S "$CHAIN" 2>/dev/null)" || return 34
  expected="-N $CHAIN"

  for src in "${SOURCES[@]}"
  do
    expected="$expected
-A $CHAIN -s $src -j RETURN"
  done

  expected="$expected
-A $CHAIN -j DROP"

  [ "$actual" = "$expected" ] || {
    echo "VERIFY_EXPECTED_BEGIN"
    printf '%s\n' "$expected"
    echo "VERIFY_EXPECTED_END"
    echo "VERIFY_ACTUAL_BEGIN"
    printf '%s\n' "$actual"
    echo "VERIFY_ACTUAL_END"
    return 35
  }

  return 0
}

apply_rules() {
  "$IPT" -w 5 -t filter -S DOCKER-USER >/dev/null 2>&1 || return 11

  if ! chain_exists; then
    "$IPT" -w 5 -t filter -N "$CHAIN" || return 12
  fi

  remove_jump || return $?

  "$IPT" -w 5 -t filter -F "$CHAIN" || return 13

  local src
  for src in "${SOURCES[@]}"
  do
    "$IPT" -w 5 -t filter -A "$CHAIN" -s "$src" -j RETURN || return 14
  done

  "$IPT" -w 5 -t filter -A "$CHAIN" -j DROP || return 15

  "$IPT" -w 5 -t filter -I DOCKER-USER 1 "${jump_args[@]}" || return 16

  verify_rules || return $?
  return 0
}

remove_rules() {
  if "$IPT" -w 5 -t filter -S DOCKER-USER >/dev/null 2>&1; then
    remove_jump || return $?
  fi

  if chain_exists; then
    "$IPT" -w 5 -t filter -F "$CHAIN" || return 41
    "$IPT" -w 5 -t filter -X "$CHAIN" || return 42
  fi

  return 0
}

case "${1:-}" in
  apply)
    apply_rules
    rc=$?
    echo "FDS_HBR_AC04_APPLY_RC=$rc"
    exit "$rc"
    ;;
  verify)
    verify_rules
    rc=$?
    echo "FDS_HBR_AC04_VERIFY_RC=$rc"
    exit "$rc"
    ;;
  remove)
    remove_rules
    rc=$?
    echo "FDS_HBR_AC04_REMOVE_RC=$rc"
    exit "$rc"
    ;;
  *)
    echo "usage: $0 {apply|verify|remove}" >&2
    exit 64
    ;;
esac
