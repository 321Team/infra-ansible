# Managed by infra-ansible for P1-HBR-01 AC-04.
# Dedicated FORWARD enforcement for Docker-published Harbor TCP/443.
# Docker/firewalld-owned tables and chains are intentionally not modified.
table inet p1_hbr_ac04 {
  set allowed_v4 {
    type ipv4_addr
    flags interval
    elements = {
{% for source in hbr_ac04_sources %}
      {{ source.address }}{{ "," if not loop.last else "" }}
{% endfor %}
    }
  }

  chain forward_guard {
    type filter hook forward priority -1; policy accept;

    iifname "{{ hbr_ac04_interface }}" ct status dnat meta nfproto ipv4 ct original ip daddr 10.1.93.54 meta l4proto tcp ct original proto-dst {{ hbr_ac04_port }} ip saddr @allowed_v4 counter accept comment "{{ hbr_ac04_change_id }} allow approved IPv4"
    iifname "{{ hbr_ac04_interface }}" ct status dnat meta nfproto ipv4 ct original ip daddr 10.1.93.54 meta l4proto tcp ct original proto-dst {{ hbr_ac04_port }} counter drop comment "{{ hbr_ac04_change_id }} deny unapproved IPv4"
  }
}
